<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. make-msix.ps1 fills in the __PLACEHOLDERS__: the identity
     values come from Partner Center (Product identity page) and the version from flashcard_viewer. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Riffle</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Riffle" Executable="FlashcardViewer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Riffle"
        Description="Study HTML and React flashcard decks, quiz yourself, track your progress and make your own decks."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" ShortName="Riffle" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#134E4A" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Open with → Riffle" for deck files. It never changes the default app for them. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="riffledeck">
            <uap:DisplayName>Flashcard deck</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.html</uap:FileType>
              <uap:FileType>.htm</uap:FileType>
              <uap:FileType>.jsx</uap:FileType>
              <uap:FileType>.tsx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
